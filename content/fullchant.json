[
{
"s": "open",
"n": 1,
"sp": null,
"sa": [
"शुक्लाम्बरधरं विष्णुं शशिवर्णं चतुर्भुजम् ।",
"प्रसन्नवदनं ध्यायेत् सर्वविघ्नोपशान्तये ॥१॥"
],
"tr": [
"śuklāmbaradharaṃ viṣṇuṃ śaśivarṇaṃ chaturbhujam |",
"prasannavadanaṃ dhyāyet sarvavighnopaśāntaye ||1||"
],
"spt": null
},
{
"s": "open",
"n": 2,
"sp": null,
"sa": [
"यस्य द्विरदवक्त्राद्याः पारिषद्याः परः शतम् ।",
"विघ्नं निघ्नन्ति सततं विष्वक्सेनं तमाश्रये ॥२॥"
],
"tr": [
"yasya dviradavaktrādyāḥ pāriṣadyāḥ paraḥ śatam |",
"vighnaṃ nighnanti satataṃ viṣvaksenaṃ tamāśraye ||2||"
],
"spt": null
},
{
"s": "open",
"n": 3,
"sp": null,
"sa": [
"व्यासं वसिष्ठनप्तारं शक्तेः पौत्रमकल्मषम् ।",
"पराशरात्मजं वन्दे शुकतातं तपोनिधिम् ॥३॥"
],
"tr": [
"vyāsaṃ vasiṣṭhanaptāraṃ śakteḥ pautramakalmaṣam |",
"parāśarātmajaṃ vande śukatātaṃ taponidhim ||3||"
],
"spt": null
},
{
"s": "open",
"n": 4,
"sp": null,
"sa": [
"व्यासाय विष्णुरूपाय व्यासरूपाय विष्णवे ।",
"नमो वै ब्रह्मनिधये वासिष्ठाय नमो नमः ॥४॥"
],
"tr": [
"vyāsāya viṣṇurūpāya vyāsarūpāya viṣṇave |",
"namo vai brahmanidhaye vāsiṣṭhāya namo namaḥ ||4||"
],
"spt": null
},
{
"s": "open",
"n": 5,
"sp": null,
"sa": [
"अविकाराय शुद्धाय नित्याय परमात्मने ।",
"सदैकरूपरूपाय विष्णवे सर्वजिष्णवे ॥५॥"
],
"tr": [
"avikārāya śuddhāya nityāya paramātmane |",
"sadaikarūparūpāya viṣṇave sarvajiṣṇave ||5||"
],
"spt": null
},
{
"s": "open",
"n": 6,
"sp": null,
"sa": [
"यस्य स्मरणमात्रेण जन्मसंसारबन्धनात् ।",
"विमुच्यते नमस्तस्मै विष्णवे प्रभविष्णवे ॥६॥"
],
"tr": [
"yasya smaraṇamātreṇa janmasaṃsārabandhanāt |",
"vimuchyate namastasmai viṣṇave prabhaviṣṇave ||6||"
],
"spt": null
},
{
"s": "open",
"n": null,
"sp": null,
"sa": [
"ॐ नमो विष्णवे प्रभविष्णवे ।"
],
"tr": [
"Om namo viṣṇave prabhaviṣṇave |"
],
"spt": null
},
{
"s": "dial",
"n": 7,
"sp": "श्रीवैशम्पायन उवाच",
"sa": [
"श्रुत्वा धर्मानशेषेण पावनानि च सर्वशः ।",
"युधिष्ठिरः शान्तनवं पुनरेवाभ्यभाषत ॥७॥"
],
"tr": [
"śrutvā dharmānaśeṣeṇa pāvanāni cha sarvaśaḥ |",
"yudhiṣṭhiraḥ śāntanavaṃ punarevābhyabhāṣata ||7||"
],
"spt": "śrīvaiśampāyana uvācha"
},
{
"s": "dial",
"n": 8,
"sp": "युधिष्ठिर उवाच",
"sa": [
"किमेकं दैवतं लोके किं वाप्येकं परायणम् ।",
"स्तुवन्तः कं कमर्चन्तः प्राप्नुयुर्मानवाः शुभम् ॥८॥"
],
"tr": [
"kimekaṃ daivataṃ loke kiṃ vāpyekaṃ parāyaṇam |",
"stuvantaḥ kaṃ kamarchantaḥ prāpnuyurmānavāḥ śubham ||8||"
],
"spt": "yudhiṣṭhira uvācha"
},
{
"s": "dial",
"n": 9,
"sp": null,
"sa": [
"को धर्मः सर्वधर्माणां भवतः परमो मतः ।",
"किं जपन्मुच्यते जन्तुर्जन्मसंसारबन्धनात् ॥९॥"
],
"tr": [
"ko dharmaḥ sarvadharmāṇāṃ bhavataḥ paramo mataḥ |",
"kiṃ japanmuchyate janturjanmasaṃsārabandhanāt ||9||"
],
"spt": null
},
{
"s": "dial",
"n": 10,
"sp": "श्रीभीष्म उवाच",
"sa": [
"जगत्प्रभुं देवदेवमनन्तं पुरुषोत्तमम् ।",
"स्तुवन्नामसहस्रेण पुरुषः सततोत्थितः ॥१०॥"
],
"tr": [
"jagatprabhuṃ devadevamanantaṃ puruṣottamam |",
"stuvannāmasahasreṇa puruṣaḥ satatotthitaḥ ||10||"
],
"spt": "śrībhīṣma uvācha"
},
{
"s": "dial",
"n": 11,
"sp": null,
"sa": [
"तमेव चार्चयन्नित्यं भक्त्या पुरुषमव्ययम् ।",
"ध्यायन् स्तुवन्नमस्यंश्च यजमानस्तमेव च ॥११॥"
],
"tr": [
"tameva chārchayannityaṃ bhaktyā puruṣamavyayam |",
"dhyāyan stuvannamasyaṃścha yajamānastameva cha ||11||"
],
"spt": null
},
{
"s": "dial",
"n": 12,
"sp": null,
"sa": [
"अनादिनिधनं विष्णुं सर्वलोकमहेश्वरम् ।",
"लोकाध्यक्षं स्तुवन्नित्यं सर्वदुःखातिगो भवेत् ॥१२॥"
],
"tr": [
"anādinidhanaṃ viṣṇuṃ sarvalokamaheśvaram |",
"lokādhyakṣaṃ stuvannityaṃ sarvaduḥkhātigo bhavet ||12||"
],
"spt": null
},
{
"s": "dial",
"n": 13,
"sp": null,
"sa": [
"ब्रह्मण्यं सर्वधर्मज्ञं लोकानां कीर्तिवर्धनम् ।",
"लोकनाथं महद्भूतं सर्वभूतभवोद्भवम् ॥१३॥"
],
"tr": [
"brahmaṇyaṃ sarvadharmajñaṃ lokānāṃ kīrtivardhanam |",
"lokanāthaṃ mahadbhūtaṃ sarvabhūtabhavodbhavam ||13||"
],
"spt": null
},
{
"s": "dial",
"n": 14,
"sp": null,
"sa": [
"एष मे सर्वधर्माणां धर्मोऽधिकतमो मतः ।",
"यद्भक्त्या पुण्डरीकाक्षं स्तवैरर्चेन्नरः सदा ॥१४॥"
],
"tr": [
"eṣa me sarvadharmāṇāṃ dharmo'dhikatamo mataḥ |",
"yadbhaktyā puṇḍarīkākṣaṃ stavairarchennaraḥ sadā ||14||"
],
"spt": null
},
{
"s": "dial",
"n": 15,
"sp": null,
"sa": [
"परमं यो महत्तेजः परमं यो महत्तपः ।",
"परमं यो महद्ब्रह्म परमं यः परायणम् ॥१५॥"
],
"tr": [
"paramaṃ yo mahattejaḥ paramaṃ yo mahattapaḥ |",
"paramaṃ yo mahadbrahma paramaṃ yaḥ parāyaṇam ||15||"
],
"spt": null
},
{
"s": "dial",
"n": 16,
"sp": null,
"sa": [
"पवित्राणां पवित्रं यो मङ्गलानां च मङ्गलम् ।",
"दैवतं देवतानां च भूतानां योऽव्ययः पिता ॥१६॥"
],
"tr": [
"pavitrāṇāṃ pavitraṃ yo maṅgalānāṃ cha maṅgalam |",
"daivataṃ devatānāṃ cha bhūtānāṃ yo'vyayaḥ pitā ||16||"
],
"spt": null
},
{
"s": "dial",
"n": 17,
"sp": null,
"sa": [
"यतः सर्वाणि भूतानि भवन्त्यादियुगागमे ।",
"यस्मिंश्च प्रलयं यान्ति पुनरेव युगक्षये ॥१७॥"
],
"tr": [
"yataḥ sarvāṇi bhūtāni bhavantyādiyugāgame |",
"yasmiṃścha pralayaṃ yānti punareva yugakṣaye ||17||"
],
"spt": null
},
{
"s": "dial",
"n": 18,
"sp": null,
"sa": [
"तस्य लोकप्रधानस्य जगन्नाथस्य भूपते ।",
"विष्णोर्नामसहस्रं मे शृणु पापभयापहम् ॥१८॥"
],
"tr": [
"tasya lokapradhānasya jagannāthasya bhūpate |",
"viṣṇornāmasahasraṃ me śṛṇu pāpabhayāpaham ||18||"
],
"spt": null
},
{
"s": "dial",
"n": 19,
"sp": null,
"sa": [
"यानि नामानि गौणानि विख्यातानि महात्मनः ।",
"ऋषिभिः परिगीतानि तानि वक्ष्यामि भूतये ॥१९॥"
],
"tr": [
"yāni nāmāni gauṇāni vikhyātāni mahātmanaḥ |",
"ṛṣibhiḥ parigītāni tāni vakṣyāmi bhūtaye ||19||"
],
"spt": null
},
{
"s": "dial",
"n": 20,
"sp": null,
"sa": [
"ऋषिर्नाम्नां सहस्रस्य वेदव्यासो महामुनिः ।",
"छन्दोऽनुष्टुप् तथा देवो भगवान् देवकीसुतः ॥२०॥"
],
"tr": [
"ṛṣirnāmnāṃ sahasrasya vedavyāso mahāmuniḥ |",
"chhando'nuṣṭup tathā devo bhagavān devakīsutaḥ ||20||"
],
"spt": null
},
{
"s": "dial",
"n": 21,
"sp": null,
"sa": [
"अमृतांशूद्भवो बीजं शक्तिर्देवकिनन्दनः ।",
"त्रिसामा हृदयं तस्य शान्त्यर्थे विनियुज्यते ॥२१॥"
],
"tr": [
"amṛtāṃśūdbhavo bījaṃ śaktirdevakinandanaḥ |",
"trisāmā hṛdayaṃ tasya śāntyarthe viniyujyate ||21||"
],
"spt": null
},
{
"s": "dial",
"n": 22,
"sp": null,
"sa": [
"विष्णुं जिष्णुं महाविष्णुं प्रभविष्णुं महेश्वरम् ।",
"अनेकरूपदैत्यान्तं नमामि पुरुषोत्तमम् ॥२२॥"
],
"tr": [
"viṣṇuṃ jiṣṇuṃ mahāviṣṇuṃ prabhaviṣṇuṃ maheśvaram |",
"anekarūpadaityāntaṃ namāmi puruṣottamam ||22||"
],
"spt": null
},
{
"s": "nyasa",
"n": 1,
"sp": null,
"sa": [
"ॐ अस्य श्रीविष्णोर्दिव्यसहस्रनामस्तोत्रमहामन्त्रस्य ।",
"श्रीवेदव्यासो भगवान् ऋषिः । अनुष्टुप् छन्दः ।"
],
"tr": [
"Om asya śrīviṣṇordivyasahasranāmastotramahāmantrasya |",
"śrīvedavyāso bhagavān ṛṣiḥ | anuṣṭup chhandaḥ |"
],
"spt": null
},
{
"s": "nyasa",
"n": 2,
"sp": null,
"sa": [
"श्रीमहाविष्णुः परमात्मा श्रीमन्नारायणो देवता ।",
"अमृतांशूद्भवो भानुरिति बीजम् ।"
],
"tr": [
"śrīmahāviṣṇuḥ paramātmā śrīmannārāyaṇo devatā |",
"amṛtāṃśūdbhavo bhānuriti bījam |"
],
"spt": null
},
{
"s": "nyasa",
"n": 3,
"sp": null,
"sa": [
"देवकीनन्दनः स्रष्टेति शक्तिः ।",
"उद्भवः क्षोभणो देव इति परमो मन्त्रः ।"
],
"tr": [
"devakīnandanaḥ sraṣṭeti śaktiḥ |",
"udbhavaḥ kṣobhaṇo deva iti paramo mantraḥ |"
],
"spt": null
},
{
"s": "nyasa",
"n": 4,
"sp": null,
"sa": [
"शङ्खभृन्नन्दकी चक्रीति कीलकम् ।",
"शार्ङ्गधन्वा गदाधर इत्यस्त्रम् ।"
],
"tr": [
"śaṅkhabhṛnnandakī chakrīti kīlakam |",
"śārṅgadhanvā gadādhara ityastram |"
],
"spt": null
},
{
"s": "nyasa",
"n": 5,
"sp": null,
"sa": [
"रथाङ्गपाणिरक्षोभ्य इति नेत्रम् ।",
"त्रिसामा सामगः सामेति कवचम् ।"
],
"tr": [
"rathāṅgapāṇirakṣobhya iti netram |",
"trisāmā sāmagaḥ sāmeti kavacham |"
],
"spt": null
},
{
"s": "nyasa",
"n": 6,
"sp": null,
"sa": [
"आनन्दं परब्रह्मेति योनिः ।",
"ऋतुः सुदर्शनः काल इति दिग्बन्धः ।"
],
"tr": [
"ānandaṃ parabrahmeti yoniḥ |",
"ṛtuḥ sudarśanaḥ kāla iti digbandhaḥ |"
],
"spt": null
},
{
"s": "nyasa",
"n": 7,
"sp": null,
"sa": [
"श्रीविश्वरूप इति ध्यानम् ।",
"श्रीमहाविष्णुप्रीत्यर्थे सहस्रनामस्तोत्रजपे विनियोगः ॥"
],
"tr": [
"śrīviśvarūpa iti dhyānam |",
"śrīmahāviṣṇuprītyarthe sahasranāmastotrajape viniyogaḥ ||"
],
"spt": null
},
{
"s": "phala",
"n": 1,
"sp": null,
"sa": [
"इतीदं कीर्तनीयस्य केशवस्य महात्मनः ।",
"नाम्नां सहस्रं दिव्यानामशेषेण प्रकीर्तितम् ॥१॥"
],
"tr": [
"itīdaṃ kīrtanīyasya keśavasya mahātmanaḥ |",
"nāmnāṃ sahasraṃ divyānāmaśeṣeṇa prakīrtitam ||1||"
],
"spt": null
},
{
"s": "phala",
"n": 2,
"sp": null,
"sa": [
"य इदं शृणुयान्नित्यं यश्चापि परिकीर्तयेत् ।",
"नाशुभं प्राप्नुयात् किञ्चित् सोऽमुत्रेह च मानवः ॥२॥"
],
"tr": [
"ya idaṃ śṛṇuyānnityaṃ yaśchāpi parikīrtayet |",
"nāśubhaṃ prāpnuyāt kiñchit so'mutreha cha mānavaḥ ||2||"
],
"spt": null
},
{
"s": "phala",
"n": 3,
"sp": null,
"sa": [
"वेदान्तगो ब्राह्मणः स्यात् क्षत्रियो विजयी भवेत् ।",
"वैश्यो धनसमृद्धः स्यात् शूद्रः सुखमवाप्नुयात् ॥३॥"
],
"tr": [
"vedāntago brāhmaṇaḥ syāt kṣatriyo vijayī bhavet |",
"vaiśyo dhanasamṛddhaḥ syāt śūdraḥ sukhamavāpnuyāt ||3||"
],
"spt": null
},
{
"s": "phala",
"n": 4,
"sp": null,
"sa": [
"धर्मार्थी प्राप्नुयाद्धर्ममर्थार्थी चार्थमाप्नुयात् ।",
"कामानवाप्नुयात् कामी प्रजार्थी प्राप्नुयात् प्रजाम् ॥४॥"
],
"tr": [
"dharmārthī prāpnuyāddharmamarthārthī chārthamāpnuyāt |",
"kāmānavāpnuyāt kāmī prajārthī prāpnuyāt prajām ||4||"
],
"spt": null
},
{
"s": "phala",
"n": 5,
"sp": null,
"sa": [
"भक्तिमान् यः सदोत्थाय शुचिस्तद्गतमानसः ।",
"सहस्रं वासुदेवस्य नाम्नामेतत् प्रकीर्तयेत् ॥५॥"
],
"tr": [
"bhaktimān yaḥ sadotthāya śuchistadgatamānasaḥ |",
"sahasraṃ vāsudevasya nāmnāmetat prakīrtayet ||5||"
],
"spt": null
},
{
"s": "phala",
"n": 6,
"sp": null,
"sa": [
"यशः प्राप्नोति विपुलं ज्ञातिप्राधान्यमेव च ।",
"अचलां श्रियमाप्नोति श्रेयः प्राप्नोत्यनुत्तमम् ॥६॥"
],
"tr": [
"yaśaḥ prāpnoti vipulaṃ jñātiprādhānyameva cha |",
"achalāṃ śriyamāpnoti śreyaḥ prāpnotyanuttamam ||6||"
],
"spt": null
},
{
"s": "phala",
"n": 7,
"sp": null,
"sa": [
"न भयं क्वचिदाप्नोति वीर्यं तेजश्च विन्दति ।",
"भवत्यरोगो द्युतिमान् बलरूपगुणान्वितः ॥७॥"
],
"tr": [
"na bhayaṃ kvachidāpnoti vīryaṃ tejaścha vindati |",
"bhavatyarogo dyutimān balarūpaguṇānvitaḥ ||7||"
],
"spt": null
},
{
"s": "phala",
"n": 8,
"sp": null,
"sa": [
"रोगार्तो मुच्यते रोगाद्बद्धो मुच्येत बन्धनात् ।",
"भयान्मुच्येत भीतस्तु मुच्येतापन्न आपदः ॥८॥"
],
"tr": [
"rogārto muchyate rogādbaddho muchyeta bandhanāt |",
"bhayānmuchyeta bhītastu muchyetāpanna āpadaḥ ||8||"
],
"spt": null
},
{
"s": "phala",
"n": 9,
"sp": null,
"sa": [
"दुर्गाण्यतितरत्याशु पुरुषः पुरुषोत्तमम् ।",
"स्तुवन्नामसहस्रेण नित्यं भक्तिसमन्वितः ॥९॥"
],
"tr": [
"durgāṇyatitaratyāśu puruṣaḥ puruṣottamam |",
"stuvannāmasahasreṇa nityaṃ bhaktisamanvitaḥ ||9||"
],
"spt": null
},
{
"s": "phala",
"n": 10,
"sp": null,
"sa": [
"वासुदेवाश्रयो मर्त्यो वासुदेवपरायणः ।",
"सर्वपापविशुद्धात्मा याति ब्रह्म सनातनम् ॥१०॥"
],
"tr": [
"vāsudevāśrayo martyo vāsudevaparāyaṇaḥ |",
"sarvapāpaviśuddhātmā yāti brahma sanātanam ||10||"
],
"spt": null
},
{
"s": "phala",
"n": 11,
"sp": null,
"sa": [
"न वासुदेवभक्तानामशुभं विद्यते क्वचित् ।",
"जन्ममृत्युजराव्याधिभयं नैवोपजायते ॥११॥"
],
"tr": [
"na vāsudevabhaktānāmaśubhaṃ vidyate kvachit |",
"janmamṛtyujarāvyādhibhayaṃ naivopajāyate ||11||"
],
"spt": null
},
{
"s": "phala",
"n": 12,
"sp": null,
"sa": [
"इमं स्तवमधीयानः श्रद्धाभक्तिसमन्वितः ।",
"युज्येतात्मसुखक्षान्तिश्रीधृतिस्मृतिकीर्तिभिः ॥१२॥"
],
"tr": [
"imaṃ stavamadhīyānaḥ śraddhābhaktisamanvitaḥ |",
"yujyetātmasukhakṣāntiśrīdhṛtismṛtikīrtibhiḥ ||12||"
],
"spt": null
},
{
"s": "phala",
"n": 13,
"sp": null,
"sa": [
"न क्रोधो न च मात्सर्यं न लोभो नाशुभा मतिः ।",
"भवन्ति कृतपुण्यानां भक्तानां पुरुषोत्तमे ॥१३॥"
],
"tr": [
"na krodho na cha mātsaryaṃ na lobho nāśubhā matiḥ |",
"bhavanti kṛtapuṇyānāṃ bhaktānāṃ puruṣottame ||13||"
],
"spt": null
},
{
"s": "phala",
"n": 14,
"sp": null,
"sa": [
"द्यौः सचन्द्रार्कनक्षत्रा खं दिशो भूर्महोदधिः ।",
"वासुदेवस्य वीर्येण विधृतानि महात्मनः ॥१४॥"
],
"tr": [
"dyauḥ sachandrārkanakṣatrā khaṃ diśo bhūrmahodadhiḥ |",
"vāsudevasya vīryeṇa vidhṛtāni mahātmanaḥ ||14||"
],
"spt": null
},
{
"s": "phala",
"n": 15,
"sp": null,
"sa": [
"ससुरासुरगन्धर्वं सयक्षोरगराक्षसम् ।",
"जगद्वशे वर्ततेदं कृष्णस्य सचराचरम् ॥१५॥"
],
"tr": [
"sasurāsuragandharvaṃ sayakṣoragarākṣasam |",
"jagadvaśe vartatedaṃ kṛṣṇasya sacharācharam ||15||"
],
"spt": null
},
{
"s": "phala",
"n": 16,
"sp": null,
"sa": [
"इन्द्रियाणि मनो बुद्धिः सत्त्वं तेजो बलं धृतिः ।",
"वासुदेवात्मकान्याहुः क्षेत्रं क्षेत्रज्ञ एव च ॥१६॥"
],
"tr": [
"indriyāṇi mano buddhiḥ sattvaṃ tejo balaṃ dhṛtiḥ |",
"vāsudevātmakānyāhuḥ kṣetraṃ kṣetrajña eva cha ||16||"
],
"spt": null
},
{
"s": "phala",
"n": 17,
"sp": null,
"sa": [
"सर्वागमानामाचारः प्रथमं परिकल्पते ।",
"आचारप्रभवो धर्मो धर्मस्य प्रभुरच्युतः ॥१७॥"
],
"tr": [
"sarvāgamānāmāchāraḥ prathamaṃ parikalpate |",
"āchāraprabhavo dharmo dharmasya prabhurachyutaḥ ||17||"
],
"spt": null
},
{
"s": "phala",
"n": 18,
"sp": null,
"sa": [
"ऋषयः पितरो देवा महाभूतानि धातवः ।",
"जङ्गमाजङ्गमं चेदं जगन्नारायणोद्भवम् ॥१८॥"
],
"tr": [
"ṛṣayaḥ pitaro devā mahābhūtāni dhātavaḥ |",
"jaṅgamājaṅgamaṃ chedaṃ jagannārāyaṇodbhavam ||18||"
],
"spt": null
},
{
"s": "phala",
"n": 19,
"sp": null,
"sa": [
"योगो ज्ञानं तथा साङ्ख्यं विद्याः शिल्पादि कर्म च ।",
"वेदाः शास्त्राणि विज्ञानमेतत्सर्वं जनार्दनात् ॥१९॥"
],
"tr": [
"yogo jñānaṃ tathā sāṅkhyaṃ vidyāḥ śilpādi karma cha |",
"vedāḥ śāstrāṇi vijñānametatsarvaṃ janārdanāt ||19||"
],
"spt": null
},
{
"s": "phala",
"n": 20,
"sp": null,
"sa": [
"एको विष्णुर्महद्भूतं पृथग्भूतान्यनेकशः ।",
"त्रीँल्लोकान्व्याप्य भूतात्मा भुङ्क्ते विश्वभुगव्ययः ॥२०॥"
],
"tr": [
"eko viṣṇurmahadbhūtaṃ pṛthagbhūtānyanekaśaḥ |",
"trīṃllokānvyāpya bhūtātmā bhuṅkte viśvabhugavyayaḥ ||20||"
],
"spt": null
},
{
"s": "phala",
"n": 21,
"sp": null,
"sa": [
"इमं स्तवं भगवतो विष्णोर्व्यासेन कीर्तितम् ।",
"पठेद्य इच्छेत्पुरुषः श्रेयः प्राप्तुं सुखानि च ॥२१॥"
],
"tr": [
"imaṃ stavaṃ bhagavato viṣṇorvyāsena kīrtitam |",
"paṭhedya ichchhetpuruṣaḥ śreyaḥ prāptuṃ sukhāni cha ||21||"
],
"spt": null
},
{
"s": "phala",
"n": 22,
"sp": null,
"sa": [
"विश्वेश्वरमजं देवं जगतः प्रभुमव्ययम् ।",
"भजन्ति ये पुष्कराक्षं न ते यान्ति पराभवम् ॥२२॥"
],
"tr": [
"viśveśvaramajaṃ devaṃ jagataḥ prabhumavyayam |",
"bhajanti ye puṣkarākṣaṃ na te yānti parābhavam ||22||"
],
"spt": null
},
{
"s": "phala",
"n": null,
"sp": null,
"sa": [
"न ते यान्ति पराभवम् ॐ नम इति ।"
],
"tr": [
"na te yānti parābhavam Om nama iti |"
],
"spt": null
},
{
"s": "phala",
"n": 23,
"sp": "अर्जुन उवाच",
"sa": [
"पद्मपत्रविशालाक्ष पद्मनाभ सुरोत्तम ।",
"भक्तानामनुरक्तानां त्राता भव जनार्दन ॥२३॥"
],
"tr": [
"padmapatraviśālākṣa padmanābha surottama |",
"bhaktānāmanuraktānāṃ trātā bhava janārdana ||23||"
],
"spt": "arjuna uvācha"
},
{
"s": "phala",
"n": 24,
"sp": "श्रीभगवानुवाच",
"sa": [
"यो मां नामसहस्रेण स्तोतुमिच्छति पाण्डव ।",
"सोऽहमेकेन श्लोकेन स्तुत एव न संशयः ॥२४॥"
],
"tr": [
"yo māṃ nāmasahasreṇa stotumichchhati pāṇḍava |",
"so'hamekena ślokena stuta eva na saṃśayaḥ ||24||"
],
"spt": "śrībhagavānuvācha"
},
{
"s": "phala",
"n": null,
"sp": null,
"sa": [
"स्तुत एव न संशय ॐ नम इति ।"
],
"tr": [
"stuta eva na saṃśaya Om nama iti |"
],
"spt": null
},
{
"s": "phala",
"n": 25,
"sp": "व्यास उवाच",
"sa": [
"वासनाद्वासुदेवस्य वासितं भुवनत्रयम् ।",
"सर्वभूतनिवासोऽसि वासुदेव नमोऽस्तु ते ॥२५॥"
],
"tr": [
"vāsanādvāsudevasya vāsitaṃ bhuvanatrayam |",
"sarvabhūtanivāso'si vāsudeva namo'stu te ||25||"
],
"spt": "vyāsa uvācha"
},
{
"s": "phala",
"n": null,
"sp": null,
"sa": [
"श्रीवासुदेव नमोऽस्तुत ॐ नम इति ।"
],
"tr": [
"śrīvāsudeva namo'stuta Om nama iti |"
],
"spt": null
},
{
"s": "phala",
"n": 26,
"sp": "पार्वत्युवाच",
"sa": [
"केनोपायेन लघुना विष्णोर्नामसहस्रकम् ।",
"पठ्यते पण्डितैर्नित्यं श्रोतुमिच्छाम्यहं प्रभो ॥२६॥"
],
"tr": [
"kenopāyena laghunā viṣṇornāmasahasrakam |",
"paṭhyate paṇḍitairnityaṃ śrotumichchhāmyahaṃ prabho ||26||"
],
"spt": "pārvatyuvācha"
},
{
"s": "phala",
"n": 27,
"sp": "ईश्वर उवाच",
"sa": [
"श्रीराम राम रामेति रमे रामे मनोरमे ।",
"सहस्रनाम तत्तुल्यं रामनाम वरानने ॥२७॥"
],
"tr": [
"śrīrāma rāma rāmeti rame rāme manorame |",
"sahasranāma tattulyaṃ rāmanāma varānane ||27||"
],
"spt": "īśvara uvācha"
},
{
"s": "phala",
"n": null,
"sp": null,
"sa": [
"श्रीरामनाम वरानन ॐ नम इति ।"
],
"tr": [
"śrīrāmanāma varānana Om nama iti |"
],
"spt": null
},
{
"s": "phala",
"n": 28,
"sp": "ब्रह्मोवाच",
"sa": [
"नमोऽस्त्वनन्ताय सहस्रमूर्तये सहस्रपादाक्षिशिरोरुबाहवे ।",
"सहस्रनाम्ने पुरुषाय शाश्वते सहस्रकोटियुगधारिणे नमः ॥२८॥"
],
"tr": [
"namo'stvanantāya sahasramūrtaye sahasrapādākṣiśirorubāhave |",
"sahasranāmne puruṣāya śāśvate sahasrakoṭiyugadhāriṇe namaḥ ||28||"
],
"spt": "brahmovācha"
},
{
"s": "phala",
"n": null,
"sp": null,
"sa": [
"श्रीसहस्रकोटियुगधारिणे नम ॐ नम इति ।"
],
"tr": [
"śrīsahasrakoṭiyugadhāriṇe nama Om nama iti |"
],
"spt": null
},
{
"s": "phala",
"n": 29,
"sp": "सञ्जय उवाच",
"sa": [
"यत्र योगेश्वरः कृष्णो यत्र पार्थो धनुर्धरः ।",
"तत्र श्रीर्विजयो भूतिर्ध्रुवा नीतिर्मतिर्मम ॥२९॥"
],
"tr": [
"yatra yogeśvaraḥ kṛṣṇo yatra pārtho dhanurdharaḥ |",
"tatra śrīrvijayo bhūtirdhruvā nītirmatirmama ||29||"
],
"spt": "sañjaya uvācha"
},
{
"s": "phala",
"n": 30,
"sp": "श्रीभगवानुवाच",
"sa": [
"अनन्याश्चिन्तयन्तो मां ये जनाः पर्युपासते ।",
"तेषां नित्याभियुक्तानां योगक्षेमं वहाम्यहम् ॥३०॥"
],
"tr": [
"ananyāśchintayanto māṃ ye janāḥ paryupāsate |",
"teṣāṃ nityābhiyuktānāṃ yogakṣemaṃ vahāmyaham ||30||"
],
"spt": "śrībhagavānuvācha"
},
{
"s": "phala",
"n": 31,
"sp": null,
"sa": [
"परित्राणाय साधूनां विनाशाय च दुष्कृताम् ।",
"धर्मसंस्थापनार्थाय सम्भवामि युगे युगे ॥३१॥"
],
"tr": [
"paritrāṇāya sādhūnāṃ vināśāya cha duṣkṛtām |",
"dharmasaṃsthāpanārthāya sambhavāmi yuge yuge ||31||"
],
"spt": null
},
{
"s": "phala",
"n": 32,
"sp": null,
"sa": [
"आर्ताः विषण्णाः शिथिलाश्च भीताः घोरेषु च व्याधिषु वर्तमानाः ।",
"सङ्कीर्त्य नारायणशब्दमात्रं विमुक्तदुःखाः सुखिनो भवन्तु ॥३२॥"
],
"tr": [
"ārtāḥ viṣaṇṇāḥ śithilāścha bhītāḥ ghoreṣu cha vyādhiṣu vartamānāḥ |",
"saṅkīrtya nārāyaṇaśabdamātraṃ vimuktaduḥkhāḥ sukhino bhavantu ||32||"
],
"spt": null
},
{
"s": "phala",
"n": 33,
"sp": null,
"sa": [
"कायेन वाचा मनसेन्द्रियैर्वा बुद्ध्यात्मना वा प्रकृतेः स्वभावात् ।",
"करोमि यद्यत् सकलं परस्मै नारायणायेति समर्पयामि ॥३३॥"
],
"tr": [
"kāyena vāchā manasendriyairvā buddhyātmanā vā prakṛteḥ svabhāvāt |",
"karomi yadyat sakalaṃ parasmai nārāyaṇāyeti samarpayāmi ||33||"
],
"spt": null
},
{
"s": "phala",
"n": null,
"sp": null,
"sa": [
"श्रीमन्नारायणायेति समर्पयामि ।"
],
"tr": [
"śrīmannārāyaṇāyeti samarpayāmi |"
],
"spt": null
},
{
"s": "end",
"n": 1,
"sp": null,
"sa": [
"यदक्षरपदभ्रष्टं मात्राहीनं तु यद्भवेत् ।",
"तत्सर्वं क्षम्यतां देव नारायण नमोऽस्तु ते ॥"
],
"tr": [
"yadakṣarapadabhraṣṭaṃ mātrāhīnaṃ tu yadbhavet |",
"tatsarvaṃ kṣamyatāṃ deva nārāyaṇa namo'stu te ||"
],
"spt": null
},
{
"s": "end",
"n": 2,
"sp": null,
"sa": [
"विसर्गबिन्दुमात्राणि पदपादाक्षराणि च ।",
"न्यूनानि चातिरिक्तानि क्षमस्व पुरुषोत्तम ॥"
],
"tr": [
"visargabindumātrāṇi padapādākṣarāṇi cha |",
"nyūnāni chātiriktāni kṣamasva puruṣottama ||"
],
"spt": null
},
{
"s": "end",
"n": null,
"sp": null,
"sa": [
"॥ श्रीकृष्णार्पणमस्तु ॥"
],
"tr": [
"|| śrīkṛṣṇārpaṇamastu ||"
],
"spt": null
}
]